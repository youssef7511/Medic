# Copy to .env.local and fill in. NEVER commit the real file (§10).

# --- Database ---------------------------------------------------------------
# §10: the region this points at is a legal decision, not a convenience one.
# Local dev only here. Staging/prod host is resolved before the first real patient.
DATABASE_URL="postgresql://medic:medic@localhost:5432/medic?schema=public"

# --- Auth (Auth.js v5) ------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
AUTH_URL="http://localhost:3000"

# --- App-layer encryption (§3.1, §10) ---------------------------------------
# Envelope-encryption master key for notes/messages/reason-for-visit/allergies.
# In production this belongs in a KMS, not an env var. Local dev only.
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY="replace-me-with-a-32-byte-random-key"

# --- Notifications (§6, §7) -------------------------------------------------
# SMS is the primary reminder channel in this market. Fill when wired.
SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""

# --- Object storage (§8, §4b) -----------------------------------------------
# S3-compatible, private bucket, same jurisdiction as the DB (§10).
# Leave STORAGE_ENDPOINT blank to use the in-memory store (unit tests only).
# For local dev, `npm run db:storage` runs MinIO with these values:
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="medic-documents"
STORAGE_ACCESS_KEY="medic"
STORAGE_SECRET_KEY="medicminio"
