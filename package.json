{
  "name": "medic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.tsx.json --test \"src/**/*.test.ts\"",
    "worker": "tsx --env-file-if-exists=.env.local src/worker.ts",
    "e2e": "tsx --env-file-if-exists=.env.local scripts/e2e-booking.ts",
    "e2e:notes": "tsx --env-file-if-exists=.env.local scripts/e2e-notes.ts",
    "e2e:documents": "tsx --tsconfig tsconfig.tsx.json --env-file-if-exists=.env.local scripts/e2e-documents.ts",
    "demo:seed": "tsx --env-file-if-exists=.env.local scripts/demo-seed.ts",
    "demo:shots": "tsx --env-file-if-exists=.env.local scripts/screenshot.ts",
    "db:up": "docker start medic-pg || docker run -d --name medic-pg -e POSTGRES_USER=medic -e POSTGRES_PASSWORD=medic -e POSTGRES_DB=medic -p 55432:5432 postgres:16-alpine",
    "db:storage": "docker start medic-minio || docker run -d --name medic-minio -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=medic -e MINIO_ROOT_PASSWORD=medicminio minio/minio server /data --console-address :9001",
    "db:storage:bucket": "tsx --env-file-if-exists=.env.local scripts/storage-bucket.ts",
    "db:harden": "docker exec -i medic-pg psql -U medic -d medic -v ON_ERROR_STOP=1 < prisma/sql/001_hardening.sql",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "luxon": "^3.7.2",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^3.26.3",
    "otplib": "^12.0.1",
    "pg-boss": "^12.26.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
