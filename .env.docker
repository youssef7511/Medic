# Docker environment configuration
# Copy to .env.docker and fill in values for containerized dev

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://medic:medic@pg:5432/medic?schema=public"

# --- Auth (Auth.js v5) ------------------------------------------------------AUTH_SECRET="replace-with-32-byte-secret"
AUTH_URL="http://localhost:3000"

# --- App-layer encryption (§3.1, §10) ---------------------------------------
ENCRYPTION_MASTER_KEY="replace-with-32-byte-key"

# --- Notifications (§6, §7) -------------------------------------------------
SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""

# --- Object storage (§8, §4b) -----------------------------------------------
STORAGE_ENDPOINT="http://minio:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="medic-documents"
STORAGE_ACCESS_KEY="medic"
STORAGE_SECRET_KEY="medicminio"