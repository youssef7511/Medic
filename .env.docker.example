# Copy to .env.docker and provide local development values. Never commit the
# populated .env.docker file. Empty required values make Docker Compose stop
# immediately instead of starting a broken authentication server.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# The hostname MUST be `pg` inside Docker, not localhost. Example shape:
# postgresql://USER:PASSWORD@pg:5432/DATABASE?schema=public
DATABASE_URL=

# Generate both secrets independently: openssl rand -base64 32
AUTH_SECRET=
ENCRYPTION_MASTER_KEY=

# Public origin used by Auth.js. Change it to the deployed HTTPS URL in prod.
AUTH_URL=http://localhost:3000

# Production containers use AWS KMS for new clinical ciphertexts.
KMS_PROVIDER=aws
KMS_KEY_ID=
AWS_REGION=
KMS_ENDPOINT=

SMS_PROVIDER=
SMS_PROVIDER_API_KEY=
SMS_HTTP_ENDPOINT=
SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMAIL_PROVIDER_API_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
